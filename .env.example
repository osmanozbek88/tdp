# ─── Application ───
NODE_ENV=development
APP_NAME=tdp
APP_URL=http://localhost:3000
PORT=3000

# ─── Database ───
DATABASE_URL=postgresql://tdp:tdp_password@localhost:5432/tdp?schema=public

# ─── Auth (NextAuth.js) ───
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
AUTH_URL=http://localhost:3000

# ─── Provider ───
PROVIDER_TYPE=fake
# TELNA_API_KEY=sk_...
# TELNA_API_URL=https://api.telna.com/v1

# ─── Logging ───
LOG_LEVEL=debug
LOG_PRETTY=true

# ─── Docker ───
POSTGRES_USER=tdp
POSTGRES_PASSWORD=tdp_password
POSTGRES_DB=tdp
